{
  "name": "botytrader",
  "version": "0.1.0",
  "description": "Terminal-based AI trading assistant — Ink TUI, local Hugging Face ReAct agent, MCP tools, broker adapters, RAG memory.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "botytrader": "./dist/index.js"
  },
  "files": [
    "dist/",
    "config.example.toml",
    ".env.example",
    "README.md",
    "docs/"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "NODE_NO_WARNINGS=1 tsx src/index.tsx",
    "dev:watch": "NODE_NO_WARNINGS=1 tsx watch --clear-screen=false src/index.tsx",
    "start": "NODE_NO_WARNINGS=1 node dist/index.js",
    "build": "tsup",
    "compile": "pkg dist/index.cjs --target node20-linux-x64 --output bin/botytrader",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "mcp": "NODE_NO_WARNINGS=1 tsx src/mcp/server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.1",
    "@google/generative-ai": "^0.21.0",
    "@huggingface/transformers": "^4.1.0",
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "dotenv": "^16.4.5",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@yao-pkg/pkg": "^5.16.1",
    "eslint": "^8.57.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
