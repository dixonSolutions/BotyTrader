# BotyTrader — secrets template. Copy to .env and fill in values.
# NEVER COMMIT .env

# Hugging Face — required only for *gated* model repos and for memory writes
# to your HF Storage Bucket. Most public ONNX chat models work without it.
# HF_TOKEN=hf_xxxxxxxxxxxx

# Embeddings — required only when features.memory_enabled = true in config.toml
# GEMINI_API_KEY=AIzaxxxxxxxxxxxx

# Alpaca (required if broker.platform is alpaca_paper or alpaca_live)
ALPACA_API_KEY=PKxxxxxxxxxxxx
ALPACA_API_SECRET=xxxxxxxxxxxx

VANTAGE_ALPHA_API_KEY=xxxxxxxxxxxxx

# Coinbase (required if broker.platform is coinbase)
COINBASE_API_KEY=
COINBASE_API_SECRET=

# Binance (required if broker.platform is binance)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Brave — required only when features.web_search_enabled = true in config.toml
# BRAVE_API_KEY=BSAxxxxxxxxxxxx
