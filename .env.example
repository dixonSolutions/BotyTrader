# BotyTrader — secrets template. Copy to .env and fill in values.
# NEVER COMMIT .env

# --- APT publishing (maintainers only) ---
# Generate a signing key and push GitHub Actions secrets:
#   npm run apt:bootstrap-secrets
# That script writes a gitignored private key file and sets APT_GPG_KEY_ID here.
# APT_GPG_KEY_ID=longkeyid
# Private key material: .apt-gpg-private.asc (never commit; used with gh secret set)

# Hugging Face — required when model.provider = huggingface_api in config.toml;
# when sentiment.provider = huggingface_api; when features.memory_enabled = true;
# and for gated local model downloads.
# HF_TOKEN=hf_xxxxxxxxxxxx

# Embeddings — required only when features.memory_enabled = true in config.toml
# GEMINI_API_KEY=AIzaxxxxxxxxxxxx

# Alpaca (required if broker.platform is alpaca_paper or alpaca_live)
ALPACA_API_KEY=PKxxxxxxxxxxxx
ALPACA_API_SECRET=xxxxxxxxxxxx

VANTAGE_ALPHA_API_KEY=xxxxxxxxxxxxx

# Coinbase (required if broker.platform is coinbase)
COINBASE_API_KEY=
COINBASE_API_SECRET=

# Binance (required if broker.platform is binance)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Brave — required only when features.web_search_enabled = true in config.toml
# BRAVE_API_KEY=BSAxxxxxxxxxxxx

# Optional TUI pointer tuning (defaults are fine for most xterm-style terminals)
# BOTYTRADER_POINTER_ORIGIN=1
# BOTYTRADER_NO_ALT_SCREEN=1
